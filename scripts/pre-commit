#!/bin/bash
# ------------------------------------------------------------
# Qt Project Auto Formatter + Static Analysis Hook (Interactive)
# - clang-format for C++ (.cpp, .h)
# - clang-tidy   for C++ quality check (auto-fix + user confirm)
# ------------------------------------------------------------

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

cd "$(git rev-parse --show-toplevel)" || exit 1

echo -e "${GREEN}[Pre-Commit] Checking C++ and QML files...${NC}"

# ============================================================
# 1. clang-format (C++ / Header)
# ============================================================
CLANG_FORMAT_EXE=$(command -v clang-format)
if [ -z "$CLANG_FORMAT_EXE" ]; then
  echo -e "${YELLOW}clang-format not found. Skipping C++ formatting.${NC}"
else
  CHANGED_CPP=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|cc|cxx|hpp|h)$')
  if [ -n "$CHANGED_CPP" ]; then
    echo -e "${GREEN}→ Formatting C++ files...${NC}"
    echo "$CHANGED_CPP" | xargs "$CLANG_FORMAT_EXE" -i --style=file
    git add $CHANGED_CPP
  fi
fi

# ============================================================
# 2. clang-tidy (C++ quality check + auto-fix + confirm)
# ============================================================
CLANG_TIDY_EXE=$(command -v clang-tidy)
if [ -z "$CLANG_TIDY_EXE" ]; then
  echo -e "${YELLOW}clang-tidy not found. Skipping static analysis.${NC}"
else
  # --- Build path auto-detection ---
  CLANG_TIDY_DB=$(find . -maxdepth 2 -type f -name compile_commands.json -print -quit | xargs dirname 2>/dev/null)

  if [ -z "$CLANG_TIDY_DB" ]; then
    echo -e "${RED}compile_commands.json not found. Run cmake with -DCMAKE_EXPORT_COMPILE_COMMANDS=ON${NC}"
  else
    echo -e "${GREEN}→ Found compile_commands.json in: ${CLANG_TIDY_DB}${NC}"
    echo -e "${GREEN}→ Running clang-tidy quality checks (auto-fix enabled)...${NC}"

    CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -iE '\.cpp$|\.h$' | xargs -I{} realpath "{}")
    if [ -z "$CHANGED_FILES" ]; then
      echo -e "${YELLOW}No C++ source files to check.${NC}"
    else
      export CLANG_TIDY_LIGHT_CHECKS="-*,clang-analyzer-*,bugprone-*,modernize-*,readability-identifier-naming,readability-braces-around-statements"

      echo "$CHANGED_FILES" | xargs -P4 -I{} bash -c '
        echo -e "\033[0;32m[clang-tidy] Checking {}\033[0m"
        '"$CLANG_TIDY_EXE"' "{}" \
          -checks="$CLANG_TIDY_LIGHT_CHECKS" \
          --config-file=.clang-tidy \
          -p "'"$CLANG_TIDY_DB"'" \
          --quiet --fix --fix-errors \
          > /tmp/clang_tidy_$(basename {}).log 2>&1
      '

      cat /tmp/clang_tidy_*.log > /tmp/clang_tidy_all.log
      if grep -q "warning:" /tmp/clang_tidy_all.log; then
        echo -e "${YELLOW}[clang-tidy] ⚠ Code style or rule violations detected.${NC}"
        echo -e "------------------------------------------------------"
        grep "warning:" /tmp/clang_tidy_all.log | head -n 15
        echo -e "------------------------------------------------------"
        echo -ne "${YELLOW}Proceed with commit despite warnings? (y/n): ${NC}"
        read -r REPLY
        if [[ ! "$REPLY" =~ ^[Yy]$ ]]; then
          echo -e "${RED}Commit aborted due to clang-tidy warnings.${NC}"
          exit 1
        else
          echo -e "${GREEN}User confirmed: proceeding with commit.${NC}"
        fi
      fi

      # ✅ Re-stage modified files after auto-fix
      echo "$CHANGED_FILES" | xargs git add
      echo -e "${GREEN}[clang-tidy] Auto-fixed files re-staged successfully.${NC}"
    fi
  fi
fi

echo -e "${GREEN}[Pre-Commit] All checks complete.${NC}"
exit 0
